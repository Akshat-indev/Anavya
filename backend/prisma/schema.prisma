generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  agents              Agent[]
  tasks               Task[]
  memories            Memory[]
  approvals           Approval[]
  files               WorkspaceFile[]
  automations         Automation[]
  conversations       ChatConversation[]
  connectedAccounts   ConnectedAccount[]
  oauthTokens         OAuthToken[]
  telegramConnections TelegramConnection[]
  scheduledTasks      ScheduledTask[]

  @@index([email])
}

model ScheduledTask {
  id              String    @id @default(uuid())
  userId          String
  conversationId  String?
  title           String
  objective       String    @db.Text
  status          String    @default("scheduled") // scheduled | running | completed | failed | cancelled | paused
  scheduleType    String    @default("once")      // once | interval | daily | weekly
  runAt           DateTime?
  nextRunAt       DateTime?
  intervalMinutes Int?
  timeOfDay       String?                         // "HH:MM" in the task timezone
  daysOfWeek      Json?                           // [0..6], 0 = Sunday
  timezone        String    @default("UTC")
  lastRunAt       DateTime?
  lastStatus      String?
  lastError       String?   @db.Text
  lastTaskId      String?
  attempts        Int       @default(0)
  maxAttempts     Int       @default(3)
  runCount        Int       @default(0)
  lockedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, nextRunAt])
}

model ChatConversation {
  id        String        @id @default(uuid())
  userId    String
  title     String
  agentRole String        @default("coordinator")
  status    String        @default("idle")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  tasks     Task[]

  @@index([userId])
  @@index([userId, updatedAt])
}

model ChatMessage {
  id              String           @id @default(uuid())
  conversationId  String
  senderType      String           // 'user' | 'agent' | 'system' | 'tool' | 'approval'
  senderName      String?
  agentRole       String?
  content         String           @db.Text
  toolExecutionId String?
  approvalId      String?
  attachmentId    String?
  metadata        Json?
  createdAt       DateTime         @default(now())

  conversation    ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([conversationId, createdAt])
}

model ConnectedAccount {
  id                  String      @id @default(uuid())
  userId              String
  provider            String      // 'google' | 'telegram'
  accountEmail        String?
  accountName         String?
  status              String      @default("connected") // 'connected' | 'disconnected' | 'expired'
  scopes              String[]
  lastConnectedAt     DateTime    @default(now())
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthToken          OAuthToken?

  @@unique([userId, provider])
  @@index([userId])
}

model OAuthToken {
  id                   String           @id @default(uuid())
  userId               String
  connectedAccountId   String           @unique
  provider             String           // 'google'
  encryptedAccessToken String           @db.Text
  encryptedRefreshToken String?         @db.Text
  expiryDate           DateTime?
  scopes               String?          @db.Text
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedAccount     ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TelegramConnection {
  id                String    @id @default(uuid())
  userId            String    @unique
  encryptedBotToken String    @db.Text
  botUsername       String
  botId             String
  botFirstName      String?
  linkedChatId      String?
  linkedChatTitle   String?
  status            String    @default("connected")
  lastConnectedAt   DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Agent {
  id                 String   @id @default(uuid())
  userId             String
  name               String
  role               String
  description        String?  @db.Text
  category           String?  @default("general")
  avatar             String?  @default("amber")
  accentColor        String?  @default("#E9A23B")
  intro              String?  @db.Text
  personality        String?  @default("Professional")
  systemInstructions String   @db.Text
  enabledTools       String[] @default([])
  actionPermissions  Json?
  executionBehavior  Json?
  outputPreferences  Json?
  memorySettings     Json?
  isSystem           Boolean  @default(false)
  isDraft            Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, role])
}

model Task {
  id             String            @id @default(uuid())
  userId         String
  conversationId String?
  title          String
  description    String            @db.Text
  status         String            @default("pending")
  plan           Json?
  finalOutput    Json?
  error          String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  completedAt    DateTime?

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation         ChatConversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  steps                TaskStep[]
  agentExecutions      AgentExecution[]
  toolExecutions       ToolExecution[]
  approvals            Approval[]
  automationExecutions AutomationExecution[]

  @@index([userId])
  @@index([userId, status])
  @@index([conversationId])
}

model TaskStep {
  id          String    @id @default(uuid())
  taskId      String
  agentType   String
  description String    @db.Text
  status      String    @default("pending")
  input       Json?
  output      Json?
  sequence    Int
  startedAt   DateTime?
  completedAt DateTime?

  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([taskId, sequence])
}

model AgentExecution {
  id          String    @id @default(uuid())
  taskId      String
  agentType   String
  input       Json?
  output      Json?
  status      String
  error       String?   @db.Text
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model ToolExecution {
  id        String   @id @default(uuid())
  taskId    String
  toolName  String
  input     Json?
  output    Json?
  status    String
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Memory {
  id        String   @id @default(uuid())
  userId    String
  category  String
  content   String   @db.Text
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, category])
}

model Approval {
  id               String    @id @default(uuid())
  userId           String
  taskId           String
  conversationId   String?
  actionName       String
  actionArguments  Json
  status           String    @default("pending")
  resolutionReason String?   @db.Text
  createdAt        DateTime  @default(now())
  resolvedAt       DateTime?

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  task             Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([taskId])
}

model WorkspaceFile {
  id             String   @id @default(uuid())
  userId         String
  conversationId String?
  taskId         String?
  filename       String
  storagePath    String
  externalUrl    String?
  externalId     String?
  mimeType       String
  size           Int
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Automation {
  id                 String                @id @default(uuid())
  userId             String
  name               String
  description        String                @db.Text
  workflowDefinition Json
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions         AutomationExecution[]

  @@index([userId])
}

model AutomationExecution {
  id           String     @id @default(uuid())
  automationId String
  taskId       String
  status       String
  output       Json?
  createdAt    DateTime   @default(now())
  completedAt  DateTime?

  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  task         Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@index([taskId])
}
