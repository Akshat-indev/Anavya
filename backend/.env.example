PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

GEMINI_API_KEY=your_google_ai_studio_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/integrations/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=replace_with_32_char_random_encryption_key

TELEGRAM_BOT_TOKEN=your_telegram_botfather_token
TELEGRAM_WEBHOOK_SECRET=replace_with_webhook_secret_token

WORKSPACE_ROOT=./workspace
MAX_UPLOAD_SIZE_MB=10
AI_MOCK_MODE=false
